{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This package is a source-exported import surface (mirrors the W041
    // skills / W047 rl-protocol / W050 tradrl-time-machine pattern):
    // package.json "exports" point at TypeScript sources and nothing is
    // emitted as a build artifact. Tests are included so the client/
    // builder/validation laws are type-checked too — including the
    // compile-time drift guard (`SDK_DRIFT_GUARD` fails to typecheck the
    // moment the api table drifts from this surface). `rootDir` is
    // deliberately NOT set: the program pulls in the consumed api /
    // tradrl-time-machine / trajectory sources (through the registered
    // package exports) — all of which live outside this package directory.
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  }
}
