{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This package is a source-exported engine skeleton (mirrors the
    // contracts package pattern): package.json "exports" point at TypeScript
    // sources and nothing is emitted as a build artifact. Tests are included
    // so engine + contract-level assertions are type-checked too.
    // `rootDir` is deliberately NOT set: the program pulls in the consumed
    // `tradrl-world-contracts` sources through the package specifier, which
    // live outside this package directory.
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["index.ts", "clock", "world", "journal", "orderbook", "matching"]
}
