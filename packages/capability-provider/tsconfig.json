{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This package is a source-exported import surface (mirrors the
    // capability-registry / skills pattern): the package.json "exports"
    // map points at TypeScript sources and nothing is emitted as a build
    // artifact. Tests are included so the import laws are type-checked
    // too — including the contracts/capability drift guard, which pulls
    // the contract sources in through a relative import (the contracts/ui
    // precedent).
    // `rootDir` is deliberately NOT set: the program pulls in the consumed
    // `capability-registry` (W040), `skills` (W041) and `organization`
    // (W039) sources through the registered package specifiers, plus the
    // contracts/capability sources — all of which live outside this
    // package directory.
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  }
}
