{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This package is a source-exported import surface (mirrors the
    // tradrl-information / tradrl-data / tradrl-world-sim pattern):
    // package.json "exports" point at TypeScript sources and nothing is
    // emitted as a build artifact. Tests are included so the import laws
    // are type-checked too.
    // `rootDir` is deliberately NOT set: the program pulls in the consumed
    // `tradrl-world-contracts` sources (including the canonical
    // `src/agentBody.ts` this package bridges to until its subpath export
    // is registered), the `tradrl-world-sim` sources through the package
    // specifiers, and the REAL alpha world definition
    // (packages/ui/src/trading-world/runtime/engineAttachment.ts) through
    // the disclosed test seam — all of which live outside this package
    // directory.
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  }
}
