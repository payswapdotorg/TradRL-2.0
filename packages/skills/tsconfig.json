{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This package is a source-exported import surface (mirrors the
    // trajectory / capability-registry pattern): the package.json
    // "exports" map points at TypeScript sources and nothing is emitted as
    // a build artifact. Tests are included so the import laws are
    // type-checked too.
    // `rootDir` is deliberately NOT set: the program pulls in the consumed
    // `trajectory` (W037) and `capability-registry` (W040) sources — plus
    // the fixture-side `agent-world-protocol`, `learning-objectives`,
    // `tradrl-world-contracts`, `experiments`, `evaluation` and
    // `verification` sources — through the registered package specifiers,
    // all of which live outside this package directory.
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  }
}
