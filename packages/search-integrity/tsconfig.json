{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This package is a source-exported import surface (mirrors the W047
    // rl-protocol / W050 tradrl-time-machine pattern): package.json
    // "exports" point at TypeScript sources and nothing is emitted as a
    // build artifact. Tests are included so the history/integrity/overfit/
    // validation laws are type-checked too. `rootDir` is deliberately NOT
    // set: the program pulls in the consumed tradrl-time-machine /
    // rl-protocol / verification / evaluation / trajectory sources (through
    // the registered package exports) — all of which live outside this
    // package directory.
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  }
}
