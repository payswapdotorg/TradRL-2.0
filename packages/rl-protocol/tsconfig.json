{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This package is a source-exported import surface (mirrors the W035
    // agent-world-protocol / W036 learning-objectives / W037 trajectory
    // pattern): package.json "exports" point at TypeScript sources and
    // nothing is emitted as a build artifact. Tests are included so the
    // episode/batch laws are type-checked too.
    // `rootDir` is deliberately NOT set: the program pulls in the consumed
    // trajectory / learning-objectives / experiments / evaluation /
    // world-agent-runtime sources (through the registered package exports)
    // — all of which live outside this package directory. The test
    // fixtures additionally import the W037 trajectory test fixtures
    // directly (the W041 fixture lineage, the W044 cross-package
    // relative-import precedent).
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  }
}
