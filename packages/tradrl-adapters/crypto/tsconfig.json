{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // Source-exported import surface (the tradrl-data / tradrl-world-sim
    // pattern): package.json "exports" point at TypeScript sources, nothing
    // is emitted as a build artifact. Tests are included so the mapping laws
    // are type-checked too. `rootDir` is deliberately NOT set: the program
    // pulls in the consumed `tradrl-world-contracts` and `tradrl-data`
    // sources through the package specifiers, which live outside this
    // package directory (two levels up from the repository root — this
    // package is nested at packages/tradrl-adapters/crypto).
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  }
}
