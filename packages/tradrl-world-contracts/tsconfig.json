{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This package is a pure contracts surface: it exports TypeScript source
    // (see package.json "exports") and is never emitted as a build artifact.
    // Tests are included so type-level contract assertions are checked too.
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": ".",
    "types": ["node"]
  },
  // `time/` (W004 market event/time/information contracts) is included so the
  // same noEmit typecheck gates its src and compile-time contract assertions.
  "include": ["src", "test", "time/src", "time/test"]
}
