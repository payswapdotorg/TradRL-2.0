{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This package is a pure contracts surface: it exports TypeScript source
    // (see package.json "exports") and is never emitted as a build artifact.
    // Tests are included so type-level contract assertions are checked too.
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src", "test"]
}
