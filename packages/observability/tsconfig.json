{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This package is a source-exported contract surface (mirrors the W059
    // services/api + W028 tradrl-evidence pattern): package.json "exports"
    // point at TypeScript sources and nothing is emitted as a build
    // artifact. Tests are included so the event/audit construction and
    // re-validation laws are type-checked too. `rootDir` is deliberately
    // NOT set: the program pulls in the consumed api / tradrl-evidence /
    // trajectory sources (through the registered package exports) — all of
    // which live outside this package directory.
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  }
}
