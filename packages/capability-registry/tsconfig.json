{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This package is a source-exported import surface (mirrors the
    // organization / evaluation / verification pattern): the package.json
    // "exports" map points at TypeScript sources and nothing is emitted as
    // a build artifact. Tests are included so the import laws are
    // type-checked too.
    // `rootDir` is deliberately NOT set: the program pulls in the consumed
    // `cognitive-substrate` (W033), `experiments` (W037), `evaluation` +
    // `verification` (W038) and `organization` (W039) sources through the
    // registered package specifiers — all of which live outside this
    // package directory.
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  }
}
