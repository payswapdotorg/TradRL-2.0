{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // contracts/ui is a pure type-only contracts surface: no emit, no
    // package manifest, no dependencies. Tests are included so the
    // compile-time law assertions are checked too (W003 convention).
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src", "test"]
}
