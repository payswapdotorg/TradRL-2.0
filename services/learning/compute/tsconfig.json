{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // This service is a source-exported import surface (mirrors the W047
    // learning-rl pattern): package.json "exports" point at TypeScript
    // sources and nothing is emitted as a build artifact.
    // Tests are included so the plan/port/validation laws are type-checked
    // too. `rootDir` is deliberately NOT set: the program pulls in the
    // consumed populations / rl-protocol / trajectory sources (through the
    // registered package exports) — all of which live outside this package
    // directory. The test fixtures additionally import the W045 populations
    // test fixtures and the W047 learning-rl test fixtures directly (the
    // W041/W044 fixture-lineage relative-import precedent), which in turn
    // pull the body-forge / world-agent-runtime / experiments / evaluation
    // sources.
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  }
}
