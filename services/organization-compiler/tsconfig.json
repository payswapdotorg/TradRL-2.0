{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This service is a source-exported import surface (mirrors the
    // packages/* pattern; note the services/ depth — two levels up to the
    // repo root, exactly like packages/): the package.json "exports" map
    // points at TypeScript sources and nothing is emitted as a build
    // artifact. Tests are included so the import laws are type-checked too.
    // `rootDir` is deliberately NOT set: the program pulls in the consumed
    // `organization` (W039 model), `agent-body` (W032), `cognitive-substrate`
    // (W033) and `possession` (W034) sources through the registered package
    // specifiers — all of which live outside this service directory.
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  }
}
