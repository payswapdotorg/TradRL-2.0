{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This package is a source-exported import surface (mirrors the W047
    // rl-protocol / W050 tradrl-time-machine / W051 search-integrity / W052
    // evaluation-splits pattern): package.json "exports" point at TypeScript
    // sources and nothing is emitted as a build artifact. Tests are included
    // so the postmortem/lessons/validate laws are type-checked too. `rootDir`
    // is deliberately NOT set: the program pulls in the consumed evaluation /
    // verification / evaluation-splits / search-integrity / experiments /
    // trajectory sources (through the registered package exports) — all of
    // which live outside this package directory.
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  }
}
