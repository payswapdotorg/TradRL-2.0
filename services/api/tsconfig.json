{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This service is a source-exported import surface (mirrors the W047
    // learning-rl / W050 time-machine pattern): package.json "exports"
    // point at TypeScript sources and nothing is emitted as a build
    // artifact. Tests are included so the route-table construction and
    // re-validation laws are type-checked too. `rootDir` is deliberately
    // NOT set: the program pulls in the consumed tradrl-evidence /
    // tradrl-time-machine / time-machine / organization /
    // organization-compiler / trajectory sources (through the registered
    // package exports) — all of which live outside this service directory.
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  }
}
