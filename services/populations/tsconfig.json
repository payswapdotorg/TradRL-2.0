{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This service is a source-exported import surface (mirrors the
    // packages/* pattern and the W039/W041/W042/W043/W044 services; note
    // the services/ depth — two levels up to the repo root, exactly like
    // packages/): the package.json "exports" map points at TypeScript
    // sources and nothing is emitted as a build artifact. Tests are
    // included so the import laws are type-checked too. `rootDir` is
    // deliberately NOT set: the program pulls in the consumed
    // `world-agent-runtime` (W044), `capability-registry` (W040),
    // `learning-objectives` (W036 — the closed ABLATION_KINDS table the
    // W039 organization vocabulary itself imports), `skills` (the identity
    // seams), `tradrl-world-sim` (the WorldDefinition the founding gate
    // reads) and `tradrl-world-contracts` sources — plus the fixture-side
    // `body-forge` commissioning sources reached through world-agent-runtime's
    // test fixtures (relative imports, the W043/W044 precedent) — all of
    // which live outside this service directory.
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  }
}
