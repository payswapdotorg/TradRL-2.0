{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // ops/ is a plain operational-surface directory (the research/benchmarks
    // W063 precedent): no emit, no package manifest, no workspace
    // membership, no dependencies of its own. The readiness vocabulary is
    // typed DATA; the gate + re-validator re-prove every citation through
    // the consumed packages' own anchors via relative source imports.
    // `rootDir` is deliberately NOT set: the program pulls in the consumed
    // api / sdk / security / security-service / observability / operations /
    // trajectory sources, all of which live outside this directory.
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["."]
}
